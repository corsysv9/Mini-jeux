AddType application/vnd.android.package-archive .apk
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
# Le navigateur revérifie toujours le code et les pages (sinon il peut garder un ancien module
# 3D pendant des heures après une mise à jour). Les fichiers inchangés répondent 304, sans renvoi.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# Compression (Three.js passe de 600 Ko à 150 Ko)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
